---
import { siteConfig } from "../config";
---

<section id="about" class="p-8 sm:p-12 md:p-16 lg:p-24">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
    <div class="lg:col-span-4">
      <p class="font-mono text-xs tracking-[0.25em] uppercase mb-3" style={`color: ${siteConfig.accentColor}`}>01</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white">About Me</h2>
      <div class="w-[75px] h-[3px] mt-3 rounded-full" style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, transparent)`}></div>
    </div>

    <div class="lg:col-span-8 space-y-8">
      <p class="text-base sm:text-lg md:text-xl leading-relaxed text-[#a1a1ab]">
        {siteConfig.aboutMe}
      </p>

      <div class="pt-2 flex flex-wrap gap-2.5">
        {siteConfig.skills.map((skill) => (
          <span class="px-3 py-1.5 rounded-full text-sm border border-[#26262b] bg-[#151518] text-[#a1a1ab] hover:border-[#3a3a42] hover:text-white transition-colors duration-200">
            {skill}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
