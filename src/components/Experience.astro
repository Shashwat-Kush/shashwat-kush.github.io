---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <p class="font-mono text-xs tracking-[0.25em] uppercase mb-3" style={`color: ${siteConfig.accentColor}`}>03</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white">Experience</h2>
          <div class="w-[75px] h-[3px] mt-3 rounded-full" style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, transparent)`} />
        </div>

        <div class="lg:col-span-8">
          <div class="relative border-l border-[#26262b] pl-6 sm:pl-8 space-y-8">
            {siteConfig.experience.map((exp) => {
              const bullets = exp.bullets.filter((b) => b && !b.startsWith("TODO"));
              return (
                <div class="relative">
                  <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-3 h-3 rounded-full border-2 border-[#0a0a0c]" style={`background-color: ${siteConfig.accentColor}`} />
                  <div class="rounded-xl border border-[#26262b] bg-[#151518] p-4 sm:p-5 hover:border-[#3a3a42] transition-colors duration-300">
                    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                      <div>
                        <h3 class="text-base sm:text-lg font-semibold text-white">{exp.title}</h3>
                        <p class="text-sm sm:text-base" style={`color: ${siteConfig.accentColor}`}>{exp.company}</p>
                      </div>
                      <span class="text-xs font-mono text-[#62626c] whitespace-nowrap">{exp.dateRange}</span>
                    </div>
                    {bullets.length > 0 && (
                      <ul class="mt-3 space-y-1.5">
                        {bullets.map((bullet) => (
                          <li class="flex items-start">
                            <span class="inline-block w-1 h-1 rounded-full bg-[#62626c] mt-2 mr-2.5 flex-shrink-0" />
                            <span class="text-sm text-[#a1a1ab]">{bullet}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </section>
  )
}
