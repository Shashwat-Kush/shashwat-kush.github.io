---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

type Project = (typeof siteConfig.projects)[number] & {
  featured?: boolean;
  metrics?: { value: string; label: string }[];
  repo?: string;
  linkLabel?: string;
};
const projects = siteConfig.projects as Project[];
---

{
  hasProjects && (
    <section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <p class="font-mono text-xs tracking-[0.25em] uppercase mb-3" style={`color: ${siteConfig.accentColor}`}>02</p>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white">Projects</h2>
          <div class="w-[75px] h-[3px] mt-3 rounded-full" style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, transparent)`} />
        </div>

        <div class="lg:col-span-8 space-y-6">
          {projects.map((project, index) => (
            <div class={`group relative rounded-2xl transition-all duration-300 hover:-translate-y-1 ${project.featured ? "border-gradient glow-accent" : "border border-[#26262b] bg-[#151518] hover:border-[#3a3a42]"}`}>
              <div class="p-5 sm:p-7 md:p-8 space-y-4">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    {project.featured && (
                      <span class="inline-block mb-2 rounded-full px-2.5 py-0.5 text-[11px] font-medium tracking-wider uppercase" style={`background: color-mix(in srgb, ${siteConfig.accentColor} 15%, transparent); color: ${siteConfig.accentColor}`}>
                        featured
                      </span>
                    )}
                    <span class="block text-sm font-mono" style={{ color: siteConfig.accentColor }}>
                      0{index + 1}
                    </span>
                    <h3 class="text-lg sm:text-xl md:text-2xl font-bold text-white mt-1 text-balance">
                      {project.name}
                    </h3>
                  </div>
                </div>

                <p class="text-sm sm:text-base text-[#a1a1ab] leading-relaxed">
                  {project.description}
                </p>

                {project.metrics && project.metrics.length > 0 && (
                  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-1">
                    {project.metrics.map((m) => (
                      <div class="rounded-xl border border-[#26262b] bg-[#0a0a0c] px-3 py-2.5">
                        <p class="text-lg sm:text-xl font-bold" style={{ color: siteConfig.accentColor }}>{m.value}</p>
                        <p class="text-[11px] leading-snug text-[#62626c] mt-0.5">{m.label}</p>
                      </div>
                    ))}
                  </div>
                )}

                {project.skills && project.skills.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    {project.skills.map((skill) => (
                      <span class="px-2.5 py-1 rounded-md text-xs border border-[#26262b] bg-[#0a0a0c] text-[#a1a1ab]">
                        {skill}
                      </span>
                    ))}
                  </div>
                )}

                <div class="flex flex-wrap gap-3 pt-2">
                  {project.link && (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-lg px-4 py-2 text-sm font-medium text-white transition-all hover:brightness-110"
                      style={`background: linear-gradient(90deg, ${siteConfig.accentColor}, #6366f1)`}
                    >
                      {project.linkLabel ?? "View project"}
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </a>
                  )}
                  {project.repo && (
                    <a
                      href={project.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-lg border border-[#3a3a42] px-4 py-2 text-sm text-[#a1a1ab] transition-colors hover:text-white hover:border-[#62626c]"
                    >
                      GitHub
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
